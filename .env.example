# Copy to .env (never commit .env) and fill in from the Box Developer Console app.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# The Box folder with the session recordings: the number at the end of app.box.com/folder/<BOX_FOLDER_ID>
# (pasting the folder link works too)
BOX_FOLDER_ID=
# Box folder for shared transcripts, so every rater gets the same one (optional). Whoever makes
# transcripts needs Editor (upload) access to it; raters need at least Viewer access.
BOX_TRANSCRIPTS_FOLDER_ID=
# Optional: only if the app runs on a port other than 5050 (must match the Developer Console)
# BOX_REDIRECT_URI=http://localhost:5050/box/callback
